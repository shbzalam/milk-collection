# Copy to .env and adjust. Never commit .env.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=milk_collection
DB_USERNAME=milk
DB_PASSWORD=milk
SERVER_PORT=8080

# Application timezone (all local planned times are interpreted in this zone)
APP_TIME_ZONE=Asia/Kolkata

# MVP ASSUMPTION - the assignment does not specify a real holding-time threshold.
MILK_MAX_HOLDING_DURATION=PT4H

SPRING_PROFILES_ACTIVE=demo
